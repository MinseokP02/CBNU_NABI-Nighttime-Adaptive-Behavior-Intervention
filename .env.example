COMPOSE_PROJECT_NAME=nabi
POSTGRES_DB=nabi_db
POSTGRES_USER=nabi_user
POSTGRES_PASSWORD=replace_with_strong_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://nabi_user:replace_with_strong_password@db:5432/nabi_db
# Tests refuse to run unless this URL ends in /nabi_test_db.
TEST_DATABASE_URL=postgresql+psycopg://nabi_user:replace_with_strong_password@db:5432/nabi_test_db
JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Backend -> LLM server (internal API) ---
LLM_ENABLED=true
LLM_SERVER_URL=http://llm-server:8100
# Shared secret between backend and llm-server (X-Internal-Token). Use a long random value.
LLM_INTERNAL_TOKEN=replace_with_long_random_internal_token
LLM_TIMEOUT_SECONDS=12
# fallback = safe fixed reply when the LLM fails (NFR-06); error = 503 LLM_UNAVAILABLE
LLM_FAIL_MODE=fallback
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- LLM server -> model ---
# mock = deterministic template replies (no GPU); openai_compatible = vLLM/Ollama/external API
LLM_PROVIDER=mock
LLM_INFERENCE_URL=
LLM_INFERENCE_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_INFERENCE_TIMEOUT_SECONDS=8
HF_TOKEN=

# --- Analysis engine (MVP change-detection settings, not diagnosis) ---
BASELINE_WINDOW_DAYS=14
BASELINE_MIN_VALID_DAYS=10
VALID_MIN_TIME_IN_BED_MIN=180
VALID_MAX_TIME_IN_BED_MIN=960
ROBUST_Z_WARNING_THRESHOLD=2.0
ROBUST_Z_HIGH_THRESHOLD=3.0
IRREGULAR_SCHEDULE_RANGE_MIN=120
