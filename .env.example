COMPOSE_PROJECT_NAME=nabi
POSTGRES_DB=nabi_db
POSTGRES_USER=nabi_user
POSTGRES_PASSWORD=replace_with_strong_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://nabi_user:replace_with_strong_password@db:5432/nabi_db
# Tests refuse to run unless this URL ends in /nabi_test_db.
TEST_DATABASE_URL=postgresql+psycopg://nabi_user:replace_with_strong_password@db:5432/nabi_test_db
JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen2.5-7B-Instruct
BASELINE_MIN_DAYS=14
RECENT_WINDOW_DAYS=7
ROBUST_Z_WARNING_THRESHOLD=2.0
ROBUST_Z_HIGH_THRESHOLD=3.0
